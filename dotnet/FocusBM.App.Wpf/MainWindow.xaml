<Window x:Class="FocusBM.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusBM.App.Wpf"
        Title="focusBM" Height="1032" Width="1032"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Deactivated="Window_OnDeactivated">
  <Window.Resources>
    <local:ShortcutBadgeConverter x:Key="ShortcutBadgeConverter" />
    <local:AgentStatusDisplayConverter x:Key="AgentStatusDisplayConverter" />
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <local:AppIconConverter x:Key="AppIconConverter" />
    <local:PanelItemWidthConverter x:Key="PanelItemWidthConverter" />
    <local:ScaledListFontConverter x:Key="ScaledListFontConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid>
  <Border CornerRadius="12" Background="White" Margin="16" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.28" Color="#000000" />
    </Border.Effect>
    <DockPanel Margin="4">
      <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding ShortcutBar}"
                    Visibility="{Binding ShowShortcutBar, Converter={StaticResource BoolToVis}}"
                    Margin="12,0,12,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="6" Background="#E8F0FE" Padding="6,4" Margin="0,0,8,0" Cursor="Hand"
                    MouseLeftButtonUp="ShortcutBar_OnMouseLeftButtonUp">
              <StackPanel>
                <Grid Width="22" Height="22" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Bookmark.AgentEmoji}" FontFamily="Segoe UI Emoji" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding Bookmark.AgentEmoji, Converter={StaticResource NullToVisibilityConverter}}" />
                  <Image Source="{Binding Bookmark.AppName, Converter={StaticResource AppIconConverter}}" Width="20" Height="20"
                         Visibility="{Binding Bookmark.AgentEmoji, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
                </Grid>
                <TextBlock Text="{Binding DisplayLabel}" FontSize="11" Foreground="#666666" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border DockPanel.Dock="Bottom" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="12,8">
        <TextBlock Text="↑↓ 移動    ↵ 復元    ⎋ 閉じる" Foreground="#888888" FontSize="12"
                   HorizontalAlignment="Center" />
      </Border>
      <Border DockPanel.Dock="Top" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="12,10"
              MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Path Grid.Column="0" Width="16" Height="16" Margin="4,0,10,0" Stretch="Uniform" Fill="#999999"
                VerticalAlignment="Center"
                Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
          <Grid Grid.Column="1">
            <TextBlock Text="Search bookmarks..." Foreground="#AAAAAA" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="20"
                      BorderThickness="0" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                      PreviewKeyDown="SearchBox_OnKeyDown" />
          </Grid>
        </Grid>
      </Border>
      <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex}"
               BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="ResultList_OnMouseDoubleClick" PreviewKeyDown="ResultList_OnPreviewKeyDown">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <EventSetter Event="MouseEnter" Handler="ResultItem_OnMouseEnter"/>
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Width">
              <Setter.Value>
                <MultiBinding Converter="{StaticResource PanelItemWidthConverter}">
                  <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                  <Binding Path="DataContext.Settings.NormalizedColumns" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="6" Padding="8,6">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                      <Setter Property="Background" Value="#E8F0FE" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="#1A73E8" VerticalAlignment="Center">
                  <TextBlock.FontSize>
                    <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                  </TextBlock.FontSize>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value=" " />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                          <Setter Property="Text" Value="▸" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Grid Grid.Column="1" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Top">
                  <TextBlock Text="{Binding AgentEmoji}" FontFamily="Segoe UI Emoji" FontSize="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding AgentEmoji, Converter={StaticResource NullToVisibilityConverter}}" />
                  <Image Source="{Binding AppName, Converter={StaticResource AppIconConverter}}" Width="20" Height="20"
                         Visibility="{Binding AgentEmoji, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
                </Grid>
                <Border Grid.Column="2" MinWidth="20" Height="20" CornerRadius="4" Background="#E8F0FE" VerticalAlignment="Top" Margin="0,0,8,0" Padding="4,0">
                  <TextBlock Foreground="#5F6368" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.FontSize>
                      <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"
                               Converter="{StaticResource ScaledListFontConverter}" ConverterParameter="0.85" />
                    </TextBlock.FontSize>
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource ShortcutBadgeConverter}">
                        <Binding />
                        <Binding Path="DataContext.Shortcuts" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </Border>
                <StackPanel Grid.Column="3">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AgentEmoji}" FontFamily="Segoe UI Emoji" Margin="0,0,4,0"
                               Visibility="{Binding AgentEmoji, Converter={StaticResource NullToVisibilityConverter}}">
                      <TextBlock.FontSize>
                        <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                      </TextBlock.FontSize>
                    </TextBlock>
                    <TextBlock Text="{Binding AgentStatus, Converter={StaticResource AgentStatusDisplayConverter}}"
                               Foreground="{Binding AgentStatus, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}"
                               FontWeight="Bold" Margin="0,0,4,0">
                      <TextBlock.FontSize>
                        <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                      </TextBlock.FontSize>
                    </TextBlock>
                    <TextBlock Text="{Binding DisplayLabel}" FontFamily="Consolas" FontWeight="Bold"
                               Foreground="{Binding AgentStatus, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}">
                      <TextBlock.FontSize>
                        <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                      </TextBlock.FontSize>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AppName}" Foreground="#888888">
                      <TextBlock.FontSize>
                        <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"
                                 Converter="{StaticResource ScaledListFontConverter}" ConverterParameter="0.85" />
                      </TextBlock.FontSize>
                    </TextBlock>
                    <TextBlock Text=" — " Foreground="#AAAAAA"
                               Visibility="{Binding UrlHint, Converter={StaticResource NullToVisibilityConverter}}">
                      <TextBlock.FontSize>
                        <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"
                                 Converter="{StaticResource ScaledListFontConverter}" ConverterParameter="0.85" />
                      </TextBlock.FontSize>
                    </TextBlock>
                    <TextBlock Text="{Binding UrlHint}" Foreground="#AAAAAA"
                               Visibility="{Binding UrlHint, Converter={StaticResource NullToVisibilityConverter}}">
                      <TextBlock.FontSize>
                        <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"
                                 Converter="{StaticResource ScaledListFontConverter}" ConverterParameter="0.85" />
                      </TextBlock.FontSize>
                    </TextBlock>
                    <TextBlock Text="{Binding PullRequestLabel}" Foreground="#0078D4" Margin="6,0,0,0">
                      <TextBlock.FontSize>
                        <Binding Path="DataContext.Settings.EffectiveListFontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"
                                 Converter="{StaticResource ScaledListFontConverter}" ConverterParameter="0.85" />
                      </TextBlock.FontSize>
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
  <Border Background="#F2000000"
          Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}"
          MouseLeftButtonDown="PreviewOverlay_OnMouseLeftButtonDown">
    <Border x:Name="PreviewCard"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#111111"
            CornerRadius="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Esc で閉じる" Foreground="#AAAAAA" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,8"/>
        <ItemsControl ItemsSource="{Binding PreviewCaptures}" Margin="12">
          <ItemsControl.Style>
            <Style TargetType="ItemsControl">
              <Setter Property="ItemsPanel">
                <Setter.Value>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="1"/>
                  </ItemsPanelTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTiledPreview}" Value="True">
                  <Setter Property="ItemsPanel">
                    <Setter.Value>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                      </ItemsPanelTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.Style>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#111111" BorderBrush="#808080" BorderThickness="0,1,0,0"
                      Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}"
                               FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="#EEEEEE" Margin="0,0,0,6"
                               Visibility="{Binding DataContext.IsTiledPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <Border DockPanel.Dock="Top" Height="2" Background="#808080" Margin="0,0,0,8"
                            Visibility="{Binding DataContext.IsTiledPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Loaded="PreviewScroll_OnLoaded">
                      <TextBlock Text="{Binding Text}"
                                 FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                 FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Foreground="#E6E6E6" TextWrapping="Wrap"/>
                    </ScrollViewer>
                  </DockPanel>
                  <TextBlock Text="{Binding Index}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                             FontSize="72" FontWeight="Bold" Foreground="#FF1A1A"
                             Margin="0,0,8,0" IsHitTestVisible="False"
                             Visibility="{Binding DataContext.IsTiledPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Effect>
                      <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.95"/>
                    </TextBlock.Effect>
                  </TextBlock>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
  </Border>
  </Grid>
</Window>
