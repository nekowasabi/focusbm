<Window x:Class="FocusBM.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusBM.App.Wpf"
        Title="focusBM" Height="1032" Width="1032"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Deactivated="Window_OnDeactivated">
  <Window.Resources>
    <local:ShortcutBadgeConverter x:Key="ShortcutBadgeConverter" />
    <local:AgentStatusDisplayConverter x:Key="AgentStatusDisplayConverter" />
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <local:AppIconConverter x:Key="AppIconConverter" />
    <local:ScaledListFontConverter x:Key="ScaledListFontConverter" />
    <local:PromptTargetBorderConverter x:Key="PromptTargetBorderConverter" />
    <local:FractionCapConverter x:Key="FractionCapConverter" />
    <local:IndexNumberFontSizeConverter x:Key="IndexNumberFontSizeConverter" />
    <local:IndexNumberTopConverter x:Key="IndexNumberTopConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid>
  <Border CornerRadius="12" Background="White" Margin="16" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.28" Color="#000000" />
    </Border.Effect>
    <DockPanel Margin="4">
      <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding ShortcutBar}"
                    Visibility="{Binding ShowShortcutBar, Converter={StaticResource BoolToVis}}"
                    Margin="12,0,12,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="6" Background="#E8F0FE" Padding="6,4" Margin="0,0,8,0" Cursor="Hand"
                    MouseLeftButtonUp="ShortcutBar_OnMouseLeftButtonUp">
              <StackPanel>
                <Grid Width="22" Height="22" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Bookmark.AgentEmoji}" FontFamily="Segoe UI Emoji" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding Bookmark.AgentEmoji, Converter={StaticResource NullToVisibilityConverter}}" />
                  <Image Source="{Binding Bookmark.AppName, Converter={StaticResource AppIconConverter}}" Width="20" Height="20"
                         Visibility="{Binding Bookmark.AgentEmoji, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
                </Grid>
                <TextBlock Text="{Binding DisplayLabel}" FontSize="11" Foreground="#666666" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border DockPanel.Dock="Bottom" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="12,8">
        <TextBlock Text="↑↓ 移動    ↵ 復元    ⎋ 閉じる" Foreground="#888888" FontSize="12"
                   HorizontalAlignment="Center" />
      </Border>
      <Border DockPanel.Dock="Top" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="12,10"
              MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Path Grid.Column="0" Width="16" Height="16" Margin="4,0,10,0" Stretch="Uniform" Fill="#999999"
                VerticalAlignment="Center"
                Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
          <Grid Grid.Column="1">
            <TextBlock Text="Search bookmarks..." Foreground="#AAAAAA" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="20"
                      BorderThickness="0" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                      PreviewKeyDown="SearchBox_OnKeyDown" />
          </Grid>
        </Grid>
      </Border>
      <Border DockPanel.Dock="Top" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,8,10,6">
        <Grid TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="#888888">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="キー" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="状態" />
          <TextBlock Grid.Column="2" Text="名前" />
          <TextBlock Grid.Column="3" Text="アプリ／端末" />
          <TextBlock Grid.Column="4" Text="PR／URL" />
        </Grid>
      </Border>
      <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex}"
               BorderThickness="0" Background="Transparent" Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="ResultList_OnMouseDoubleClick" PreviewKeyDown="ResultList_OnPreviewKeyDown">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <EventSetter Event="MouseEnter" Handler="ResultItem_OnMouseEnter"/>
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="10,7" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                      <Setter Property="Background" Value="#E8F0FE" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="3" HorizontalAlignment="Left" Margin="-10,-7,0,-7" Fill="#1A73E8">
                  <Rectangle.Style>
                    <Style TargetType="Rectangle">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Rectangle.Style>
                </Rectangle>
                <TextBlock Grid.Column="0" FontFamily="Consolas" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{Binding DataContext.Settings.EffectiveListFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource ShortcutBadgeConverter}">
                      <Binding />
                      <Binding Path="DataContext.Shortcuts" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                    </MultiBinding>
                  </TextBlock.Text>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#5F6368" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                          <Setter Property="Foreground" Value="#1A73E8" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                           Fill="{Binding AgentStatus, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}"
                           Visibility="{Binding AgentStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                  <TextBlock Text="{Binding AgentStatus, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=label}"
                             VerticalAlignment="Center"
                             FontSize="{Binding DataContext.Settings.EffectiveListFontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ScaledListFontConverter}, ConverterParameter=0.85}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#5F6368" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding AgentStatus}" Value="{x:Null}">
                            <Setter Property="Foreground" Value="#AAAAAA" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <DockPanel Grid.Column="2" VerticalAlignment="Center">
                  <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0">
                    <TextBlock Text="{Binding AgentEmoji}" FontFamily="Segoe UI Emoji" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding AgentEmoji, Converter={StaticResource NullToVisibilityConverter}}" />
                    <Image Source="{Binding AppName, Converter={StaticResource AppIconConverter}}" Width="20" Height="20"
                           Visibility="{Binding AgentEmoji, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
                  </Grid>
                  <TextBlock Text="{Binding ListName}" FontWeight="SemiBold" Foreground="#222222"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             FontSize="{Binding DataContext.Settings.EffectiveListFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </DockPanel>
                <TextBlock Grid.Column="3" Text="{Binding ListDetail}" Foreground="#888888"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontSize="{Binding DataContext.Settings.EffectiveListFontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ScaledListFontConverter}, ConverterParameter=0.85}" />
                <TextBlock Grid.Column="4" Text="{Binding PullRequestLabel}" Foreground="#0078D4" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding PullRequestLabel, Converter={StaticResource NullToVisibilityConverter}}"
                           FontSize="{Binding DataContext.Settings.EffectiveListFontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ScaledListFontConverter}, ConverterParameter=0.85}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
  <Border Background="#F20D1117"
          Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}"
          MouseLeftButtonDown="PreviewOverlay_OnMouseLeftButtonDown">
    <Border x:Name="PreviewCard"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#0D1117"
            CornerRadius="8">
      <DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="Esc で閉じる" Foreground="#6E7681" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,8"/>
        <Border x:Name="PromptEntryPanel" DockPanel.Dock="Bottom" Padding="12,4,12,0"
                Visibility="{Binding IsPromptAvailable, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <Border Background="#161B22" BorderBrush="#58A6FF" BorderThickness="1" CornerRadius="10"
                    MinHeight="54" Padding="14,0">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PromptTargetLabel}" Foreground="#58A6FF"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                           Visibility="{Binding PromptTargetLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                <Grid Grid.Column="1">
                  <TextBox x:Name="PromptBox" Text="{Binding PromptDraft, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="False" TextWrapping="NoWrap" FontSize="15" Foreground="#E6EDF3"
                           CaretBrush="#E6EDF3" BorderThickness="0" Background="Transparent" Padding="0,5"
                           GotKeyboardFocus="PromptBox_OnGotKeyboardFocus"
                           LostKeyboardFocus="PromptBox_OnLostKeyboardFocus" />
                  <TextBlock Text="{Binding PromptPlaceholder}" Foreground="#6E7681" FontSize="15"
                             Margin="2,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding PromptDraft}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
            </Border>
            <TextBlock Text="{Binding PromptError}" Foreground="#FFA198" FontSize="12" Margin="2,6,0,0"
                       Visibility="{Binding PromptError, Converter={StaticResource NullToVisibilityConverter}}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding PreviewCaptures}" Margin="6">
          <ItemsControl.Style>
            <Style TargetType="ItemsControl">
              <Setter Property="ItemsPanel">
                <Setter.Value>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="1"/>
                  </ItemsPanelTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTiledPreview}" Value="True">
                  <Setter Property="ItemsPanel">
                    <Setter.Value>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                      </ItemsPanelTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.Style>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="6">
                <Border x:Name="TargetGlow" Margin="-3" CornerRadius="13" BorderThickness="3"
                        BorderBrush="#4058A6FF" Visibility="Collapsed" />
                <Border x:Name="PaneCard" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Height="3" CornerRadius="9,9,0,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{Binding Status, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                              <Setter Property="Background" Value="#8B949E" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="16,9,16,8">
                      <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                            Visibility="{Binding Status, Converter={StaticResource NullToVisibilityConverter}}">
                        <Border CornerRadius="10" Opacity="0.14"
                                Background="{Binding Status, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}" />
                        <StackPanel Orientation="Horizontal" Margin="10,3">
                          <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Fill="{Binding Status, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}" />
                          <TextBlock Text="{Binding Status, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=label}"
                                     Foreground="{Binding Status, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}"
                                     FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Title}" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border x:Name="PreviewBody" Background="#0D1117" CornerRadius="6" Margin="10,0,10,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Why: every tile's index sits at the same height, level with the end of the longest output, in a left gutter where the eye returns after each line. -->
                        <Viewbox Grid.Column="0" StretchDirection="DownOnly" VerticalAlignment="Top"
                                 Width="{Binding ActualHeight, ElementName=PreviewBody, Converter={StaticResource FractionCapConverter}, ConverterParameter='0.25,80'}"
                                 Visibility="{Binding DataContext.IsTiledPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                          <Viewbox.Margin>
                            <MultiBinding Converter="{StaticResource IndexNumberTopConverter}">
                              <Binding Path="DataContext.PreviewMaxLineCount" RelativeSource="{RelativeSource AncestorType=Window}" />
                              <Binding Path="DataContext.PreviewFontSize" RelativeSource="{RelativeSource AncestorType=Window}" />
                              <Binding Path="ActualHeight" ElementName="PreviewBody" />
                            </MultiBinding>
                          </Viewbox.Margin>
                          <TextBlock x:Name="IndexNumber" Text="{Binding Index}" Opacity="0.55"
                                     FontFamily="Segoe UI" FontWeight="Bold" IsHitTestVisible="False" LineStackingStrategy="BlockLineHeight"
                                     FontSize="{Binding ActualHeight, ElementName=PreviewBody, Converter={StaticResource IndexNumberFontSizeConverter}}"
                                     LineHeight="{Binding ActualHeight, ElementName=PreviewBody, Converter={StaticResource IndexNumberFontSizeConverter}}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource AgentStatusDisplayConverter}, ConverterParameter=color}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="#8B949E" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Viewbox>
                        <ScrollViewer Grid.Column="1" Margin="12,10" VerticalScrollBarVisibility="Auto"
                                      Loaded="PreviewScroll_OnLoaded" Binding.TargetUpdated="PreviewScroll_OnLoaded">
                          <TextBlock Foreground="#C9D1D9" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight"
                                     FontFamily="{Binding DataContext.PreviewFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                     FontSize="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                     LineHeight="{Binding DataContext.PreviewFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScaledListFontConverter}, ConverterParameter=1.5}"
                                     local:AnsiInlines.Text="{Binding Text, NotifyOnTargetUpdated=True}"/>
                        </ScrollViewer>
                      </Grid>
                    </Border>
                  </DockPanel>
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Value="True">
                  <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource PromptTargetBorderConverter}">
                      <Binding Path="Index" />
                      <Binding Path="DataContext.PromptTargetIndex" RelativeSource="{RelativeSource AncestorType=Window}" />
                      <Binding Path="DataContext.IsTiledPreview" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                  </DataTrigger.Binding>
                  <Setter TargetName="TargetGlow" Property="Visibility" Value="Visible" />
                  <Setter TargetName="PaneCard" Property="BorderBrush" Value="#58A6FF" />
                  <Setter TargetName="IndexNumber" Property="Opacity" Value="1" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
  </Border>
  </Grid>
</Window>
